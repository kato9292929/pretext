---
import '../index.css'
import Analytics from '@vercel/analytics/astro'

// Google Analytics 4: set PUBLIC_GA_MEASUREMENT_ID (e.g. G-XXXXXXXXXX) in the
// Vercel project's environment variables. Without it, no GA tag is emitted.
const gaId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '').trim()
const ga = /^G-[A-Z0-9]+$/.test(gaId) ? gaId : ''
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Apply the saved theme before first paint (the HTML is built in the dark default). -->
    <script is:inline>
      try {
        var t = localStorage.getItem('x402-theme')
        document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark')
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark')
      }
    </script>
    {
      ga && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} />
          <script is:inline define:vars={{ ga }}>
            window.dataLayer = window.dataLayer || []
            function gtag() {
              dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', ga, { anonymize_ip: true })
          </script>
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Vercel Web Analytics (cookieless). Enable it in the Vercel project → Analytics. -->
    <Analytics />
  </body>
</html>
