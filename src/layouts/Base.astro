---
import '../index.css'
import Analytics from '@vercel/analytics/astro'
---
<!doctype html>
<html lang="ja">
  <head>
    <!-- Google tag (GTM-TCCLRSSL): Google Analytics etc., managed in Google Tag Manager -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-TCCLRSSL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- AdSense site verification only (no ad script): ads run on the media subdomain, not on this site -->
    <meta name="google-adsense-account" content="ca-pub-3829432471595699" />
    <!-- Apply the saved theme before first paint (the HTML is built in the dark default). -->
    <script is:inline>
      try {
        var t = localStorage.getItem('x402-theme')
        document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark')
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark')
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Vercel Web Analytics (cookieless). Enable it in the Vercel project → Analytics. -->
    <Analytics />
  </body>
</html>
