---
import Base from '../layouts/Base.astro'
import { AboutApp } from '../apps'
---
<Base>
  <Fragment slot="head">
      <meta name="description" content="x402 で「1リクエストごとに USDC を払う」決済はすでに動いている。残っている問題は、初めて会う売り手にエージェントが安心して払えるかである。認可・履行・評判の3つに分けて、標準で決まっていることと空白を整理する。">
      <title>未知の売り手とエージェントが取引するための3つの確認：認可・履行・評判 — x402 Inc.</title>
      <link rel="icon" type="image/svg+xml" href="/favicon.svg">

      <meta property="og:type" content="website">
      <meta property="og:url" content="https://x402jp.com/about.html">
      <meta property="og:title" content="未知の売り手とエージェントが取引するための3つの確認：認可・履行・評判 — x402 Inc.">
      <meta property="og:description" content="x402 で「1リクエストごとに USDC を払う」決済はすでに動いている。残っている問題は、初めて会う売り手にエージェントが安心して払えるかである。認可・履行・評判の3つに分けて、標準で決まっていることと空白を整理する。">
      <meta property="og:image" content="https://x402jp.com/og-image.png?v=2">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:locale" content="ja_JP">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="https://x402jp.com/og-image.png?v=2">
  </Fragment>
  <div id="root">
    <AboutApp client:load />
  </div>
</Base>
