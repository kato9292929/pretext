---
import Base from '../layouts/Base.astro'
import { AboutApp } from '../apps'
---
<Base>
  <Fragment slot="head">
      <meta name="description" content="パーソナルエージェントは Stripe Link で支払い、API には x402 で1コールずつ払う。x402 Inc. のカタログ（x402 Endpoint）、買い手、売り手、市場（RFQ Market・Seller Probe）と、支払える API の一覧。">
      <title>エージェント決済 — Muse・Grok の Stripe Link から x402 の per-call まで | x402 Inc.</title>
      <link rel="icon" type="image/svg+xml" href="/favicon.svg">

      <meta property="og:type" content="website">
      <meta property="og:url" content="https://x402jp.com/about.html">
      <meta property="og:title" content="エージェント決済 — Muse・Grok の Stripe Link から x402 の per-call まで | x402 Inc.">
      <meta property="og:description" content="パーソナルエージェントは Stripe Link で支払い、API には x402 で1コールずつ払う。x402 Inc. のカタログ（x402 Endpoint）、買い手、売り手、市場（RFQ Market・Seller Probe）と、支払える API の一覧。">
      <meta property="og:image" content="https://x402jp.com/og-image.png?v=2">
